# PostgreSQL Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# NextAuth / JWT
NEXTAUTH_SECRET=generate_a_secure_random_secret_here
NEXTAUTH_URL=http://localhost:3000

# Backend Encryption Key (32 bytes hex or base64) for encrypting Wi-Fi passwords at rest
ENCRYPTION_KEY=generate_a_secure_32_byte_key_here

# Firebase Admin Service Account
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_CLIENT_EMAIL=your_service_account_email_here
FIREBASE_PRIVATE_KEY="your_private_key_here"

# Admin Initial Setup (Only used on first seed, do not use real production passwords here)
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=development_password_only
